# Copie para .env e ajuste.

# PostgreSQL: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/smartcampus

# Claude (opcional). Sem chave, o assistente roda em modo offline.
ANTHROPIC_API_KEY=
# auto | claude | offline
MODO_ASSISTENTE=auto
CLAUDE_MODELO=claude-opus-5-5
# low | medium | high
CLAUDE_EFFORT=medium

# ChromaDB
CHROMA_PATH=./chroma_db
TOP_K=4
# padrao = all-MiniLM-L6-v2 embutido no ChromaDB.
# Para português, opcional: paraphrase-multilingual-MiniLM-L12-v2 (pip install sentence-transformers)
EMBEDDING_MODELO=padrao
